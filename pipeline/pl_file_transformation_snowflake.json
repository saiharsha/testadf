{
	"name": "pl_file_transformation_snowflake",
	"properties": {
		"activities": [
			{
				"name": "iterate_sheetnames",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_sheet_names_csv",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_sheet_names_csv').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "DF_transform_sheet_data_to_csv",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow3_snowflake",
									"type": "DataFlowReference",
									"parameters": {
										"filename": "\"PolicyClaim_Validated.xlsx\"",
										"sheetname": "\"work_claim\""
									},
									"datasetParameters": {
										"source1": {
											"filename": {
												"value": "@pipeline().parameters.filename",
												"type": "Expression"
											},
											"sheetname": {
												"value": "@item().sheetname",
												"type": "Expression"
											}
										},
										"sink1": {
											"tablename": {
												"value": "@concat(toUpper(split(item().sheetname,'_')[1]),'_STG')",
												"type": "Expression"
											}
										}
									}
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			},
			{
				"name": "Lookup_sheet_names_csv",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Ds_sheetnames",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"filename": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Proper_column_validation_pipelines"
		},
		"annotations": [],
		"lastPublishTime": "2025-02-13T12:15:12Z"
	}
}